-col a:hover {color: var(--primary)}\n        @media (max-width: 768px) {\n            .hero-content {padding-right: 20px;text-align: center}\n            .hero-content h1 {font-size: 2.8rem}\n            .plans {flex-direction: column}\n        }\n    </style><header>\n        <div class=\"container\">\n            <div class=\"header-content\">\n                <div class=\"logo\">飞飞网络</div>\n                <nav>\n                    <a href=\"#plans\">套餐</a>\n                    <a href=\"#faq\">常见问题</a>\n                    <a href=\"#\">帮助中心</a>\n                </nav>\n            </div>\n        </div>\n    </header>\n\n    <div class=\"breadcrumb\">\n        <div class=\"container\">\n            <a href=\"#\">首页</a> / <a href=\"#\">产品</a>\n        </div>\n    </div>\n\n    \n    <section class=\"hero\">\n        <div class=\"container\">\n            <div class=\"hero-content\">\n                <h1>飞飞网络 · 安全透明的加密网络服务</h1>\n                <p>我们为您提供层层加密的网络通道，帮助您在任何地点访问内容时都保持隐私和速度。</p>\n                <a href=\"#plans\" class=\"hero-cta\">立即了解套餐</a>\n            </div>\n            <div class=\"hero-visual\">\n                <div class=\"hero-visual-content\">\n                    <p>全球节点<br>即时连接<br>零延迟</p>\n                </div>\n            </div>\n        </div>\n    </section>\n\n    \n    <section class=\"section\" id=\"plans\">\n        <div class=\"container\">\n            <h2>选择适合您的套餐</h2>\n            <div class=\"plans\">\n                \n                <div class=\"plan\">\n                    <div class=\"plan-header\">\n                        <div class=\"plan-number\">01</div>\n                        <div class=\"plan-details\">\n                            <div class=\"plan-name\">基础版</div>\n                            <div class=\"plan-price\">¥15/月</div>\n                            <div class=\"plan-annual\">按年付仅需 ¥150/年</div>\n                        </div>\n                    </div>\n                    <div class=\"plan-features\">\n                        <ul>\n                            <li>每月 100GB 极速流量</li>\n                            <li>支持 3 台设备同时在线</li>\n                            <li>解锁基础流媒体</li>\n                            <li>普通线路节点池</li>\n                        </ul>\n                    </div>\n                </div>\n\n                \n                <div class=\"plan\">\n                    <div class=\"plan-header\">\n                        <div class=\"plan-number\">02</div>\n                        <div class=\"plan-details\">\n                            <div class=\"plan-name\">旗舰版</div>\n                            <div class=\"plan-price\">¥35/月</div>\n                            <div class=\"plan-annual\">按年付仅需 ¥350/年</div>\n                        </div>\n                    </div>\n                    <div class=\"plan-features\">\n                        <ul>\n                            <li>每月 300GB 极速流量</li>\n                            <li>支持 5 台设备同时在线</li>\n                            <li>全节点原生流媒体解锁</li>\n                            <li>IPLC 专线游戏加速优化</li>\n                            <li>7x24 优先工单支持</li>\n                        </ul>\n                    </div>\n                </div>\n\n                \n                <div class=\"plan\">\n                    <div class=\"plan-header\">\n                        <div class=\"plan-number\">03</div>\n                        <div class=\"plan-details\">\n                            <div class=\"plan-name\">团队版</div>\n                            <div class=\"plan-price\">¥85/月</div>\n                            <div class=\"plan-annual\">按年付仅需 ¥850/年</div>\n                        </div>\n                    </div>\n                    <div class=\"plan-features\">\n                        <ul>\n                            <li>每月 1000GB 极速流量</li>\n                            <li>支持 20 台设备同时在线</li>\n                            <li>VIP 专属高带宽节点</li>\n                            <li>支持企业定制路由</li>\n                            <li>专属客户经理服务</li>\n                        </ul>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </section>\n\n    \n    <section class=\"section\" id=\"faq\">\n        <div class=\"container\">\n            <h2>常见问题</h2>\n            <div class=\"faq\">\n                \n                <div class=\"faq-item\">\n                    <div class=\"faq-question\">什么是飞飞网络？</div>\n                    <div class=\"faq-answer\">\n                        飞飞网络是一个提供加密网络通道的服务，帮助用户在任何地点访问内容时保持隐私和速度。我们采用现代加密技术，确保您的连接安全且透明。\n                    </div>\n                </div>\n\n                \n                <div class=\"faq-item\">\n                    <div class=\"faq-question\">基础版和旗舰版有什么区别？</div>\n                    <div class=\"faq-answer\">\n                        基础版提供每月 100GB 流量和 3 台设备同时在线。旗舰版升级到每月 300GB 流量、5 台设备支持以及 IPLC 专线游戏加速，适合需要更高流量的用户。\n                    </div>\n                </div>\n\n                \n                <div class=\"faq-item\">\n                    <div class=\"faq-question\">如何开始使用？</div>\n                    <div class=\"faq-answer\">\n                        您可以直接在我们的官网上注册账号，选择适合的套餐，然后通过提供的指引设置您的加密网络连接。整个过程简单且快速。\n                    </div>\n                </div>\n\n                \n                <div class=\"faq-item\">\n                    <div class=\"faq-question\">支持多少设备同时在线？</div>\n                    <div class=\"faq-answer\">\n                        基础版支持 3 台，旗舰版支持 5 台，团队版支持 20 台。不同的套餐根据您的需求和流量分配有相应的限制。\n                    </div>\n                </div>\n\n                \n                <div class=\"faq-item\">\n                    <div class=\"faq-question\">流量如何计算？</div>\n                    <div class=\"faq-answer\">\n                        每月流量以使用量为准。任何剩余流量可以自动续费或升级到更高套餐。详细信息请参考套餐页面的说明。\n                    </div>\n                </div>\n\n                \n                <div class=\"faq-item\">\n                    <div class=\"faq-question\">是否支持游戏加速？</div>\n                    <div class=\"faq-answer\">\n                        旗舰版及以上套餐支持 IPLC 专线游戏加速优化，能有效减少延迟，提升游戏体验。\n                    </div>\n                </div>\n\n                \n                <div class=\"faq-item\">\n                    <div class=\"faq-question\">服务提供商是否透明？</div>\n                    <div class=\"faq-answer\">\n                        我们提供透明的节点信息和使用统计，确保用户随时了解网络状态和流量使用情况。\n                    </div>\n                </div>\n            </div>\n        </div>\n    </section>\n\n    <footer class=\"footer\">\n        <div class=\"container\">\n            <div class=\"footer-content\">\n                <div>\n                    <div class=\"footer-col\">\n                        <h4>飞飞网络</h4>\n                        <a href=\"#\">关于我们</a>\n                        <a href=\"#\">联系我们</a>\n                        <a href=\"#\">隐私政策</a>\n                    </div>\n                </div>\n                <div>\n                    <div class=\"footer-col\">\n                        <h4>快速链接</h4>\n                        <a href=\"#plans\">套餐详情</a>\n                        <a href=\"#\">帮助中心</a>\n                        <a href=\"#\">更新日志</a>\n                    </div>\n                </div>\n                <div>\n                    <div class=\"footer-col\">\n                        <h4>公司信息</h4>\n                        <p>飞飞网络专注于安全透明的加密网络服务。</p>\n                        <a href=\"#\">© 2026 飞飞网络</a>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </footer></main>",
